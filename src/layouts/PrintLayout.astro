---
import content from '../data/content.json';

const title = `${content.sidebar.name} — Resume`;
const description = content['career-profile'].summary.replace(/\s+/g, ' ').trim();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="plain-print">
    <slot />
  </body>
</html>
